# Environment Configuration Example
NODE_ENV=development
PORT=3000

# MongoDB connection string for Prisma. A Replica Set is required for Transactions.
# Example: mongodb://localhost:27018/academix?replicaSet=rs0
DATABASE_URL="mongodb://localhost:27018/academix?replicaSet=rs0"

# Cache & Rate Limiting
# Redis connection URL.
REDIS_URL="redis://localhost:6379"

# Authentication
# Secret key used to sign JWT tokens. Keep this highly secure!
JWT_SECRET="your-super-secret-jwt-key-change-in-production-at-least-32-chars"
JWT_EXPIRES_IN="1d"
