generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  email          String          @unique
  passwordHash   String
  role           Role            @default(STUDENT)
  firstName      String
  lastName       String
  phoneNumber    String?
  lastLoginAt    DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  adminProfile   AdminProfile?
  hodProfile     HodProfile?
  studentProfile StudentProfile?

  @@index([role])
}

model Department {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String           @unique
  code      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  courses       Course[]
  hod           HodProfile?
  programs      Program[]
  students      StudentProfile[]
}

model AdminProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HodProfile {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @unique @db.ObjectId
  departmentId String     @unique @db.ObjectId
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       HodStatus  @default(ACTIVE)
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model StudentProfile {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @unique @db.ObjectId
  rollNumber         String        @unique
  departmentId       String        @db.ObjectId
  currentSemester    Int
  batch              String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  programId          String?       @db.ObjectId
  registrationNumber String?       @unique
  sectionId          String?       @db.ObjectId
  semesterId         String?       @db.ObjectId
  status             StudentStatus @default(ACTIVE)
  attendance         Attendance[]
  enrollments        Enrollment[]
  department         Department    @relation(fields: [departmentId], references: [id])
  program            Program?      @relation(fields: [programId], references: [id])
  section            Section?      @relation(fields: [sectionId], references: [id])
  semester           Semester?     @relation(fields: [semesterId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([currentSemester])
  @@index([programId])
  @@index([semesterId])
  @@index([sectionId])
}

model Course {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String          @unique
  credits        Int
  departmentId   String          @db.ObjectId
  programId      String?         @db.ObjectId
  semester       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendance     Attendance[]
  department     Department      @relation(fields: [departmentId], references: [id])
  program        Program?        @relation(fields: [programId], references: [id])
  enrollments    Enrollment[]
  syllabus       Syllabus?
  courseOutcomes CourseOutcome[]
  units          Unit[]

  @@index([departmentId])
  @@index([programId])
}

model Enrollment {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String         @db.ObjectId
  courseId     String         @db.ObjectId
  semester     Int
  academicYear String
  grade        String?
  marks        Float?
  gpa          Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
}

model Attendance {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId String           @db.ObjectId
  courseId  String           @db.ObjectId
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
}

model Program {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  name         String           @unique
  code         String           @unique
  departmentId String           @db.ObjectId
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      StudentProfile[]
  courses       Course[]

  @@index([departmentId])
}

model Semester {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  semesterNumber Int
  programId      String           @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       Section[]
  program        Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  students       StudentProfile[]

  @@unique([programId, semesterNumber])
  @@index([programId])
}

model Section {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  semesterId String           @db.ObjectId
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  semester   Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students   StudentProfile[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

enum Role {
  ADMIN
  HOD
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}



enum HodStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Syllabus {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId         String   @unique @db.ObjectId
  fileUrl          String
  originalFileName String
  uploadDate       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseOutcome {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  coNumber    String   // e.g., "CO1", "CO2" or "1"
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, coNumber])
  @@index([courseId])
}

model Unit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  unitNumber  Int      // e.g., 1, 2, 3
  unitName    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([courseId, unitNumber])
  @@index([courseId])
}

model Topic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId      String   @db.ObjectId
  topicName   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

