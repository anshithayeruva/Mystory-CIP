generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  email            String            @unique
  passwordHash     String
  role             Role              @default(STUDENT)
  firstName        String
  lastName         String
  phoneNumber      String?
  lastLoginAt      DateTime?
  isActive         Boolean           @default(true)
  twoFactorEnabled     Boolean           @default(false)
  mustChangePassword   Boolean           @default(true)
  createdBy            String?           @db.ObjectId
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  adminProfile     AdminProfile?
  facultyProfile   FacultyProfile?
  hodProfile       HodProfile?
  studentProfile   StudentProfile?
  reports          Report[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]


  @@index([role])
}

model Department {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String           @unique
  code          String           @unique
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  courses       Course[]
  faculty       FacultyProfile[]
  hod           HodProfile?
  programs      Program[]
  students      StudentProfile[]
  pulseSessions PulseSession[]
  events        Event[]
}

model AdminProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HodProfile {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @unique @db.ObjectId
  departmentId String     @unique @db.ObjectId
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       HodStatus  @default(ACTIVE)
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacultyProfile {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String          @unique @db.ObjectId
  employeeId     String          @unique
  designation    String
  departmentId   String          @db.ObjectId
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  status         FacultyStatus   @default(ACTIVE)
  profilePicture String?
  officeLocation String?
  officeHours    String?
  bio            String?
  specialization String?
  contactEmail   String?
  contactPhone   String?
  courses        FacultyCourse[]
  pulseSessions  PulseSession[]
  department     Department      @relation(fields: [departmentId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model StudentProfile {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  userId              String               @unique @db.ObjectId
  rollNumber          String               @unique
  departmentId        String               @db.ObjectId
  currentSemester     Int
  batch               String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  programId           String?              @db.ObjectId
  registrationNumber  String?              @unique
  sectionId           String?              @db.ObjectId
  semesterId          String?              @db.ObjectId
  address             String?
  emergencyContact    String?
  learningMode        String?              @default("Hybrid / Classroom")
  status              StudentStatus        @default(ACTIVE)
  attendance          Attendance[]
  enrollments         Enrollment[]
  pulseParticipations PulseParticipation[]
  assignmentSubmissions AssignmentSubmission[]
  generatedReports    GeneratedReport[]
  notificationSettings StudentNotificationSettings?
  documents           StudentDocument[]
  department          Department           @relation(fields: [departmentId], references: [id])
  program             Program?             @relation(fields: [programId], references: [id])
  section             Section?             @relation(fields: [sectionId], references: [id])
  semester            Semester?            @relation(fields: [semesterId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([currentSemester])
  @@index([programId])
  @@index([semesterId])
  @@index([sectionId])
}

model Course {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String               @unique
  credits        Int
  departmentId   String               @db.ObjectId
  programId      String?              @db.ObjectId
  semester       Int?
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attendance     Attendance[]
  department     Department           @relation(fields: [departmentId], references: [id])
  program        Program?             @relation(fields: [programId], references: [id])
  enrollments    Enrollment[]
  facultyCourses FacultyCourse[]
  syllabus       Syllabus?
  courseOutcomes CourseOutcome[]
  units          Unit[]
  pulseSessions  PulseSession[]
  conceptGaps    ConceptGapAnalysis[]

  @@index([departmentId])
  @@index([programId])
}

model Enrollment {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String         @db.ObjectId
  courseId     String         @db.ObjectId
  semester     Int
  academicYear String
  grade        String?
  marks        Float?
  gpa          Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
}

model Attendance {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId String           @db.ObjectId
  courseId  String           @db.ObjectId
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
}

model FacultyCourse {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  facultyId    String         @db.ObjectId
  courseId     String         @db.ObjectId
  section      String
  semester     Int
  academicYear String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classSchedules ClassSchedule[]
  assignments    Assignment[]

  @@unique([facultyId, courseId, section, academicYear, semester])
  @@index([facultyId])
  @@index([courseId])
}

model Program {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String           @unique
  code          String           @unique
  departmentId  String           @db.ObjectId
  degreeLevel   String?
  duration      String?
  intake        Int?
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      StudentProfile[]
  courses       Course[]
  pulseSessions PulseSession[]

  @@index([departmentId])
}

model Semester {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  semesterNumber Int
  programId      String           @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       Section[]
  program        Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  students       StudentProfile[]

  @@unique([programId, semesterNumber])
  @@index([programId])
}

model Section {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  semesterId String           @db.ObjectId
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  semester   Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students   StudentProfile[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

enum Role {
  ADMIN
  HOD
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum HodStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Syllabus {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId         String   @unique @db.ObjectId
  fileUrl          String
  originalFileName String
  uploadDate       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseOutcome {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  coNumber    String // e.g., "CO1", "CO2" or "1"
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, coNumber])
  @@index([courseId])
}

model Unit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  unitNumber  Int // e.g., 1, 2, 3
  unitName    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([courseId, unitNumber])
  @@index([courseId])
}

model Topic {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  unitId             String               @db.ObjectId
  topicName          String
  description        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  unit               Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  pulseSessions      PulseSession[]
  conceptGapAnalyses ConceptGapAnalysis[]

  @@index([unitId])
}

enum PulseSessionType {
  MID_CLASS_CHECK
  END_OF_CLASS_CHECK
  END_OF_DAY_REVIEW
  WEEKLY_REVISION
  LAB_UNDERSTANDING_CHECK
  TUTORIAL_SESSION
  REMEDIAL_SESSION
  PLACEMENT_TRAINING_SESSION
  CONTEST_PREPARATION_SESSION
}

enum PulseQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum PulseDifficultyLevel {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum PulseAttendanceRule {
  ATTEMPT_REQUIRED
  QR_ATTENDANCE_ONLY
  BOTH
}

enum PulseResultVisibility {
  FACULTY_ONLY
  STUDENTS_AFTER_SESSION
  IMMEDIATE
}

enum PulseSessionStatus {
  DRAFT
  PUBLISHED
  LIVE
  PAUSED
  COMPLETED
  CLOSED
  ARCHIVED
}

enum PulseTimerStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETED
}

model PulseSession {
  id                    String                @id @default(auto()) @map("_id") @db.ObjectId
  courseId              String                @db.ObjectId
  topicId               String                @db.ObjectId
  departmentId          String                @db.ObjectId
  programId             String?               @db.ObjectId
  semester              Int
  section               String
  facultyId             String                @db.ObjectId
  sessionType           PulseSessionType
  title                 String
  description           String?
  date                  DateTime
  startTime             String
  durationMinutes       Int
  questionCount         Int
  questionType          PulseQuestionType
  difficultyLevel       PulseDifficultyLevel
  attendanceRule        PulseAttendanceRule
  resultVisibility      PulseResultVisibility
  status                PulseSessionStatus    @default(DRAFT)
  sessionCode           String?               @unique
  codeCreatedAt         DateTime?
  codeExpiresAt         DateTime?
  isCodeActive          Boolean               @default(false)
  qrCodeUrl             String?
  timerStatus           PulseTimerStatus      @default(IDLE)
  timerDurationMinutes  Int?
  timerActualStartTime  DateTime?
  timerActualEndTime    DateTime?
  timerRemainingSeconds Int?
  publishImmediately    Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic          Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  department     Department           @relation(fields: [departmentId], references: [id])
  program        Program?             @relation(fields: [programId], references: [id])
  faculty        FacultyProfile       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  questions      PulseQuestion[]
  participations PulseParticipation[]
  liveSession    LiveSession?
  sessionSummary SessionSummary?

  @@index([courseId])
  @@index([topicId])
  @@index([departmentId])
  @@index([programId])
  @@index([facultyId])
  @@index([date])
  @@index([status])
}

model PulseQuestion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String   @db.ObjectId
  questionNumber Int
  questionText   String
  options        String[]
  correctAnswer  String
  marks          Float    @default(1.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session      PulseSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers      PulseAnswer[]
  liveSessions LiveSession[]

  @@unique([sessionId, questionNumber])
  @@index([sessionId])
}

model PulseParticipation {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String    @db.ObjectId
  studentId        String    @db.ObjectId
  isPresent        Boolean   @default(true)
  hasAttempted     Boolean   @default(false)
  score            Float?
  maxScore         Float?
  percentage       Float?
  timeTakenSeconds Int?
  attemptedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  session PulseSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers PulseAnswer[]

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model PulseAnswer {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  participationId  String   @db.ObjectId
  questionId       String   @db.ObjectId
  studentAnswer    String
  isCorrect        Boolean
  marksAwarded     Float    @default(0.0)
  timeTakenSeconds Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  participation PulseParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  question      PulseQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participationId, questionId])
  @@index([participationId])
  @@index([questionId])
}

model Institution {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  code              String?
  type              String?
  address           String?
  country           String?
  logo              String?
  academicYear      String?
  semester          String?
  operationalStatus String   @default("LIVE")
  status            Boolean  @default(true)
  contactPerson     String?
  contactEmail      String?
  contactNumber     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AcademicSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  attendanceModel         String   @default("Activity Based (Auto-tracked)")
  minQuestionAttempt      Int      @default(75)
  minSessionTime          Int      @default(45)
  allowLateSubmission     Boolean  @default(true)
  deviceVerification      Boolean  @default(false)
  
  passingPercentage       Int      @default(40)
  defaultDuration         Int      @default(120)
  maxAttempts             Int      @default(2)
  allowRetests            Boolean  @default(true)
  randomizeQuestions      Boolean  @default(true)
  
  marksPerQuestion        Int      @default(1)
  partialMarking          Boolean  @default(false)
  negativeMarking         Boolean  @default(false)
  difficultyBasedMarks    Boolean  @default(true)
  staffOverride           Boolean  @default(true)
  
  visScore                Boolean  @default(true)
  visCorrectAnswers       Boolean  @default(true)
  visExplanations         Boolean  @default(false)
  visClassAverage         Boolean  @default(false)
  visRank                 Boolean  @default(false)

  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

model SecuritySettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  pwdMinLength            Int      @default(12)
  pwdRequireUppercase     Boolean  @default(true)
  pwdRequireNumbers       Boolean  @default(true)
  pwdRequireSpecial       Boolean  @default(true)
  
  sessionTimeoutMins      Int      @default(30)
  autoLogout              Boolean  @default(true)
  concurrentLoginLimit    String   @default("3 Devices")
  
  twoFactorAuth           Boolean  @default(false)
  otpLogin                Boolean  @default(true)

  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

model IntegrationSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  erpSystem               Boolean  @default(true)
  moodle                  Boolean  @default(false)
  googleClassroom         Boolean  @default(true)
  microsoftTeams          Boolean  @default(true)
  canvas                  Boolean  @default(false)

  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  action       String
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  departmentId String?  @db.ObjectId
  date         DateTime
  time         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
}

model Report {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  type         String
  exportFormat String?  @default("PDF")
  generatedBy  String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [generatedBy], references: [id])
}

model ApprovalRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  type        String
  status      String   @default("PENDING")
  requestedBy String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [requestedBy], references: [id])
}

model LiveSession {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  pulseSessionId    String            @unique @db.ObjectId
  status            LiveSessionStatus @default(NOT_STARTED)
  startedAt         DateTime?
  endedAt           DateTime?
  activeStudents    Int               @default(0)
  sessionProgress   Float             @default(0.0)
  currentQuestionId String?           @db.ObjectId

  pulseSession    PulseSession   @relation(fields: [pulseSessionId], references: [id], onDelete: Cascade)
  currentQuestion PulseQuestion? @relation(fields: [currentQuestionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LiveSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  ENDED
}

model SessionSummary {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  pulseSessionId       String   @unique @db.ObjectId
  attendanceCount      Int      @default(0)
  averageScore         Float    @default(0.0)
  averageUnderstanding Float    @default(0.0)
  weakConcepts         String[]
  strongConcepts       String[]
  participationRate    Float    @default(0.0)
  completionTimeAvg    Float    @default(0.0)
  recommendations      String[]

  pulseSession PulseSession @relation(fields: [pulseSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConceptGapAnalysis {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId             String   @db.ObjectId
  topicId              String   @db.ObjectId
  averageUnderstanding Float    @default(0.0)
  studentsAtRisk       Int      @default(0)
  weakAreas            String[]
  strongAreas          String[]
  trend                String
  recommendations      String[]

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([topicId])
}

model ClassSchedule {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  facultyCourseId String        @db.ObjectId
  dayOfWeek       String
  startTime       String
  endTime         String
  room            String
  type            String        // Lecture, Lab, Tutorial

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  facultyCourse   FacultyCourse @relation(fields: [facultyCourseId], references: [id], onDelete: Cascade)
  
  @@index([facultyCourseId])
}

model Assignment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  facultyCourseId String        @db.ObjectId
  title           String
  description     String?
  dueDate         DateTime
  dueTime         String?
  maxMarks        Float         @default(100.0)
  priority        String        @default("MEDIUM")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  facultyCourse   FacultyCourse @relation(fields: [facultyCourseId], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]
  
  @@index([facultyCourseId])
}

model AssignmentSubmission {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId   String         @db.ObjectId
  studentId      String         @db.ObjectId
  status         String         @default("PENDING") // PENDING, SUBMITTED, OVERDUE, GRADED
  obtainedMarks  Float?
  feedback       String?
  submissionDate DateTime?
  fileUrl        String?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  assignment     Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model GeneratedReport {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String         @db.ObjectId
  title       String
  type        String         // "ATTENDANCE_ANALYTICS" or "CONCEPT_UNDERSTANDING"
  fileUrl     String
  createdAt   DateTime       @default(now())
  
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentNotificationSettings {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId          String         @unique @db.ObjectId
  timetableReminders Boolean        @default(true)
  attendanceAlerts   Boolean        @default(true)
  resourceUploads    Boolean        @default(true)
  weeklyDigest       Boolean        @default(false)
  updatedAt          DateTime       @updatedAt
  
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String         @db.ObjectId
  name        String
  category    String
  status      String         // e.g., "VERIFIED", "PAID", "ISSUED"
  fileUrl     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
