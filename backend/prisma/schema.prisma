generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  role           Role            @default(STUDENT)
  firstName      String
  lastName       String
  phoneNumber    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  adminProfile   AdminProfile?
  facultyProfile FacultyProfile?
  hodProfile     HodProfile?
  studentProfile StudentProfile?

  @@index([email])
  @@index([role])
}

model Department {
  id        String           @id @default(uuid())
  name      String           @unique
  code      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  courses   Course[]
  faculty   FacultyProfile[]
  hod       HodProfile?
  programs  Program[]
  students  StudentProfile[]
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HodProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  departmentId String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       HodStatus  @default(ACTIVE)
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacultyProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  employeeId   String          @unique
  designation  String
  departmentId String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       FacultyStatus   @default(ACTIVE)
  courses      FacultyCourse[]
  department   Department      @relation(fields: [departmentId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model StudentProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique
  rollNumber         String        @unique
  departmentId       String
  currentSemester    Int
  batch              String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  programId          String?
  registrationNumber String?       @unique
  sectionId          String?
  semesterId         String?
  status             StudentStatus @default(ACTIVE)
  attendance         Attendance[]
  enrollments        Enrollment[]
  department         Department    @relation(fields: [departmentId], references: [id])
  program            Program?      @relation(fields: [programId], references: [id])
  section            Section?      @relation(fields: [sectionId], references: [id])
  semester           Semester?     @relation(fields: [semesterId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([currentSemester])
  @@index([programId])
  @@index([semesterId])
  @@index([sectionId])
}

model Course {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  credits        Int
  departmentId   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendance     Attendance[]
  department     Department      @relation(fields: [departmentId], references: [id])
  enrollments    Enrollment[]
  facultyCourses FacultyCourse[]

  @@index([departmentId])
}

model Enrollment {
  id           String         @id @default(uuid())
  studentId    String
  courseId     String
  semester     Int
  academicYear String
  grade        String?
  marks        Float?
  gpa          Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  courseId  String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
}

model FacultyCourse {
  id           String         @id @default(uuid())
  facultyId    String
  courseId     String
  section      String
  semester     Int
  academicYear String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, courseId, section, academicYear, semester])
  @@index([facultyId])
  @@index([courseId])
}

model Program {
  id           String           @id @default(uuid())
  name         String           @unique
  code         String           @unique
  departmentId String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters    Semester[]
  students     StudentProfile[]

  @@index([departmentId])
}

model Semester {
  id             String           @id @default(uuid())
  semesterNumber Int
  programId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       Section[]
  program        Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  students       StudentProfile[]

  @@unique([programId, semesterNumber])
  @@index([programId])
}

model Section {
  id         String           @id @default(uuid())
  name       String
  semesterId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  semester   Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students   StudentProfile[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

enum Role {
  ADMIN
  HOD
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum HodStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
