# Environment Configuration Example
NODE_ENV=development
PORT=3000

# Database
# PostgreSQL connection string for Prisma.
# Replace with your actual credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_analytics?schema=public"

# Cache & Rate Limiting
# Redis connection URL.
REDIS_URL="redis://localhost:6379"

# Authentication
# Secret key used to sign JWT tokens. Keep this highly secure!
JWT_SECRET="your-super-secret-jwt-key-change-in-production-at-least-32-chars"
JWT_EXPIRES_IN="1d"
