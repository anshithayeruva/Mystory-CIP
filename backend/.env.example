# Environment Configuration Example
NODE_ENV=development
PORT=5000

# MongoDB connection string for Prisma. A Replica Set is required for Transactions.
# Example: mongodb://localhost:27017/mystory?replicaSet=true
DATABASE_URL="mongodb://localhost:27017/mystory?replicaSet=true"
MONGODB_URI="mongodb://localhost:27017/mystory?replicaSet=true"

# Cache & Rate Limiting
# Redis connection URL.
REDIS_URL=

# Authentication
# Secret key used to sign JWT tokens. Keep this highly secure!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# Email / SMTP (Nodemailer)
# Use any SMTP provider: Gmail (App Password), Brevo, Mailgun, etc.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<App Password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@mystory.edu

# Frontend URL (used in credential email links)
FRONTEND_URL=http://localhost:3000